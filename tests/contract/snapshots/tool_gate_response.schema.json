    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "resume": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolGateResume"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "risk_flags": {
      "items": {
        "type": "string"
      },
      "title": "Risk Flags",
      "type": "array"
    }
  },
  "required": [
    "decision"
  ],
  "title": "ToolGateResponse",
  "type": "object"
}
