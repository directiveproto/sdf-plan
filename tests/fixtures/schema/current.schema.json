{
  "$defs": {
    "LintItem": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "level": {
          "enum": [
            "WARN",
            "ERROR"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        }
      },
      "required": [
        "level",
        "code",
        "message"
      ],
      "title": "LintItem",
      "type": "object"
    },
    "PlanStep": {
      "properties": {
        "confirm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirm"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "fallback": {
          "title": "Fallback",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "io": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepIO"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retry": {
          "default": 0,
          "title": "Retry",
          "type": "integer"
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepStop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop_condition": {
          "title": "Stop Condition",
          "type": "string"
        },
        "time_budget_sec": {
          "default": 0,
          "title": "Time Budget Sec",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "intent",
        "stop_condition",
        "fallback"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "PolicySummary": {
      "properties": {
        "confirm_required_steps_count": {
          "title": "Confirm Required Steps Count",
          "type": "integer"
        },
        "risk_flags_count": {
          "title": "Risk Flags Count",
          "type": "integer"
        }
      },
      "required": [
        "risk_flags_count",
        "confirm_required_steps_count"
